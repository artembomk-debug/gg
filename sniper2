with acs as (


SELECT
   acs.account_id as account_id ,
   acs.ga_session_id,
   sp.continent,
   sp.device,
   sp.country,
   sp.channel,
   sp.language,
   sp.mobile_model_name,
   sp.operating_system
 FROM
   `DA.account_session` acs
 JOIN
   `DA.session_params` sp
 ON
   acs.ga_session_id = sp.ga_session_id ),
     es as (SELECT
 es.id_account as account_id , es.id_message, 1 AS sent,


   
   es.id_message AS id_message_sent,


 
   eo.id_message AS id_message_open,
 
   ev.id_message AS id_message_visit,
    CASE WHEN eo.id_message IS NOT NULL THEN 1 ELSE 0 END AS opened,
 CASE WHEN ev.id_message IS NOT NULL THEN 1 ELSE 0 END AS visited,
   eo.letter_type AS letter_type_open,
   eo.open_date,


   ev.letter_type AS letter_type_visit,
 
 FROM
   `DA.email_sent` es
 LEFT JOIN
     `DA.email_open` eo
 ON
   es.id_message = eo.id_message
 LEFT JOIN
     `DA.email_visit` ev
 ON
   es.id_message = ev.id_message)
select acs.operating_system,
 COUNT(DISTINCT sent) AS sent_msg,
 COUNT(DISTINCT  opened) AS open_msg,
 COUNT(DISTINCT visited) AS vist_msg,
  COUNT(DISTINCT id_message_open) / COUNT(DISTINCT id_message_sent) * 100 AS open_rate,
 COUNT(DISTINCT id_message_visit) / COUNT(DISTINCT id_message_sent) * 100 AS click_rate,
 COUNT(DISTINCT id_message_visit) / COUNT(DISTINCT id_message_open) * 100 AS ctor
 from acs
 join es using(account_id )
 join `DA.account` a
 on a.id = account_id  
 WHERE
 a.is_unsubscribed = 0
GROUP BY
 acs.operating_system
